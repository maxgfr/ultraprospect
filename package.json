{
  "name": "ultraprospect",
  "version": "2.0.0",
  "description": "Turn a place into a qualified prospect list — keyless discovery from OpenStreetMap worldwide plus whichever company register a country actually has, matched into one entity, enriched two tiers deep from each company's own website, and written up as citation-checked dossiers. A skills.sh agent skill.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "ultraprospect": "scripts/ultraprospect.mjs"
  },
  "files": [
    "skills",
    "scripts",
    "assets",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "verify:bundle": "node scripts/verify-skill-bundle.mjs",
    "verify:engine": "node scripts/verify-engine-usage.mjs",
    "check:build": "tsup && node scripts/copy-bundle.mjs && git diff --exit-code -- scripts/ultraprospect.mjs skills/ultraprospect/scripts/ultraprospect.mjs && node scripts/verify-skill-bundle.mjs && node scripts/sync-engine.mjs --check && node scripts/verify-engine-usage.mjs",
    "demo": "node scripts/ultraprospect.mjs scan --fixture assets/fixtures/vincennes --out /tmp/ultraprospect-demo",
    "eval": "node evals/run.mjs --suite offline",
    "eval:network": "node evals/run.mjs --suite network",
    "release": "semantic-release"
  },
  "keywords": [
    "skills",
    "agent-skill",
    "skills.sh",
    "prospecting",
    "lead-generation",
    "openstreetmap",
    "overpass-api",
    "company-registry",
    "open-data",
    "sirene",
    "companies-house",
    "vies",
    "gleif",
    "nace",
    "geocoding",
    "web-scraping",
    "ai-agent",
    "mcp"
  ],
  "license": "MIT",
  "author": "maxgfr",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxgfr/ultraprospect"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.10",
    "semantic-release": "^24.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
